NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb+srv://username:password@example.mongodb.net/naughty-jars
JWT_SECRET=replace-with-at-least-32-random-bytes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only required for the one-time admin seeder.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Must be explicitly enabled before running seed:products.
ALLOW_DESTRUCTIVE_SEED=false
